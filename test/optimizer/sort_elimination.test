# name: test/optimizer/sort_elimination.test
# description: Test sort elimination optimization for Parquet files with sorting_columns metadata
# group: [optimizer]

require parquet

# Test files with sorting_columns metadata (generated by data/parquet-testing/generate_sorted_parquet.py)

# ==============================================================================
# SECTION 1: Basic Sort Elimination
# ==============================================================================

# ------------------------------------------------------------------------------
# Test 1.1: Exact match - ORDER BY matches sorting_columns -> no ORDER_BY in plan
# ------------------------------------------------------------------------------

# File is sorted by i ASC NULLS LAST
query II
EXPLAIN SELECT * FROM 'data/parquet-testing/sorted_i_asc.parquet' ORDER BY i ASC NULLS LAST
----
physical_plan	<!REGEX>:.*ORDER_BY.*

# Verify correctness
query I
SELECT * FROM 'data/parquet-testing/sorted_i_asc.parquet' ORDER BY i ASC NULLS LAST LIMIT 5
----
0
1
2
3
4

# ------------------------------------------------------------------------------
# Test 1.2: Descending file with matching ORDER BY -> no sort
# ------------------------------------------------------------------------------

# File is sorted by i DESC NULLS FIRST
query II
EXPLAIN SELECT * FROM 'data/parquet-testing/sorted_i_desc.parquet' ORDER BY i DESC NULLS FIRST
----
physical_plan	<!REGEX>:.*ORDER_BY.*

# Verify correctness
query I
SELECT * FROM 'data/parquet-testing/sorted_i_desc.parquet' ORDER BY i DESC NULLS FIRST LIMIT 5
----
999
998
997
996
995

# ------------------------------------------------------------------------------
# Test 1.3: Prefix match - ORDER BY on first column of multi-column sort -> no sort
# ------------------------------------------------------------------------------

# File is sorted by (i ASC, j ASC)
query II
EXPLAIN SELECT * FROM 'data/parquet-testing/sorted_ij_asc.parquet' ORDER BY i ASC NULLS LAST
----
physical_plan	<!REGEX>:.*ORDER_BY.*

# Full match on both columns -> no sort
query II
EXPLAIN SELECT * FROM 'data/parquet-testing/sorted_ij_asc.parquet' ORDER BY i ASC NULLS LAST, j ASC NULLS LAST
----
physical_plan	<!REGEX>:.*ORDER_BY.*

# ------------------------------------------------------------------------------
# Test 1.4: Multiple row groups with same sorting -> no sort
# ------------------------------------------------------------------------------

query II
EXPLAIN SELECT * FROM 'data/parquet-testing/sorted_multi_rowgroup.parquet' ORDER BY i ASC NULLS LAST
----
physical_plan	<!REGEX>:.*ORDER_BY.*

# ==============================================================================
# SECTION 2: Column Subset Selection (not SELECT *)
# ==============================================================================

# ------------------------------------------------------------------------------
# Test 2.1: Select only the sorted column -> no sort
# ------------------------------------------------------------------------------

query II
EXPLAIN SELECT i FROM 'data/parquet-testing/sorted_i_asc.parquet' ORDER BY i ASC NULLS LAST
----
physical_plan	<!REGEX>:.*ORDER_BY.*

# Verify correctness
query I
SELECT i FROM 'data/parquet-testing/sorted_i_asc.parquet' ORDER BY i ASC NULLS LAST LIMIT 5
----
0
1
2
3
4

# ------------------------------------------------------------------------------
# Test 2.2: Select first column from multi-column sorted file -> no sort
# ------------------------------------------------------------------------------

query II
EXPLAIN SELECT i FROM 'data/parquet-testing/sorted_ij_asc.parquet' ORDER BY i ASC NULLS LAST
----
physical_plan	<!REGEX>:.*ORDER_BY.*

# ------------------------------------------------------------------------------
# Test 2.3: Select second column only, order by first -> no sort
# ------------------------------------------------------------------------------

query II
EXPLAIN SELECT j FROM 'data/parquet-testing/sorted_ij_asc.parquet' ORDER BY i ASC NULLS LAST
----
physical_plan	<!REGEX>:.*ORDER_BY.*

# ------------------------------------------------------------------------------
# Test 2.4: Select second column, order by both -> no sort
# ------------------------------------------------------------------------------

query II
EXPLAIN SELECT j FROM 'data/parquet-testing/sorted_ij_asc.parquet' ORDER BY i ASC NULLS LAST, j ASC NULLS LAST
----
physical_plan	<!REGEX>:.*ORDER_BY.*

# Verify correctness - j values cycle 0-9 for each i value
query I
SELECT j FROM 'data/parquet-testing/sorted_ij_asc.parquet' ORDER BY i ASC NULLS LAST, j ASC NULLS LAST LIMIT 5
----
0
1
2
3
4

# ==============================================================================
# SECTION 3: Partial Sorting Columns (file has more columns than sorting_columns)
# ==============================================================================

# File sorted_partial.parquet has columns (a, b, c, d) but only sorted by (a, b)

# ------------------------------------------------------------------------------
# Test 3.1: Select all, order by first sorted column -> no sort
# ------------------------------------------------------------------------------

query II
EXPLAIN SELECT * FROM 'data/parquet-testing/sorted_partial.parquet' ORDER BY a ASC NULLS LAST
----
physical_plan	<!REGEX>:.*ORDER_BY.*

# Verify correctness
query II
SELECT a, b FROM 'data/parquet-testing/sorted_partial.parquet' ORDER BY a ASC NULLS LAST LIMIT 5
----
0	0
0	1
0	2
0	3
0	4

# ------------------------------------------------------------------------------
# Test 3.2: Select subset including non-sorted column, order by sorted -> no sort
# ------------------------------------------------------------------------------

query II
EXPLAIN SELECT a, c FROM 'data/parquet-testing/sorted_partial.parquet' ORDER BY a ASC NULLS LAST
----
physical_plan	<!REGEX>:.*ORDER_BY.*

# ------------------------------------------------------------------------------
# Test 3.3: Select only non-sorted columns, order by sorted column -> no sort
# ------------------------------------------------------------------------------

query II
EXPLAIN SELECT c, d FROM 'data/parquet-testing/sorted_partial.parquet' ORDER BY a ASC NULLS LAST
----
physical_plan	<!REGEX>:.*ORDER_BY.*

# Verify correctness
query II
SELECT c, d FROM 'data/parquet-testing/sorted_partial.parquet' ORDER BY a ASC NULLS LAST LIMIT 5
----
row_0_0	0
row_0_1	1
row_0_2	2
row_0_3	3
row_0_4	4

# ------------------------------------------------------------------------------
# Test 3.4: Order by both sorted columns -> no sort
# ------------------------------------------------------------------------------

query II
EXPLAIN SELECT * FROM 'data/parquet-testing/sorted_partial.parquet' ORDER BY a ASC NULLS LAST, b ASC NULLS LAST
----
physical_plan	<!REGEX>:.*ORDER_BY.*

# ------------------------------------------------------------------------------
# Test 3.5: Order by non-sorted column -> needs sort
# ------------------------------------------------------------------------------

query II
EXPLAIN SELECT * FROM 'data/parquet-testing/sorted_partial.parquet' ORDER BY c
----
physical_plan	<REGEX>:.*ORDER_BY.*

query II
EXPLAIN SELECT * FROM 'data/parquet-testing/sorted_partial.parquet' ORDER BY d
----
physical_plan	<REGEX>:.*ORDER_BY.*

# ------------------------------------------------------------------------------
# Test 3.6: Order by sorted column followed by non-sorted -> needs sort
# ------------------------------------------------------------------------------

query II
EXPLAIN SELECT * FROM 'data/parquet-testing/sorted_partial.parquet' ORDER BY a ASC NULLS LAST, c
----
physical_plan	<REGEX>:.*ORDER_BY.*

# ------------------------------------------------------------------------------
# Test 3.7: Order by (a, b, c) when file only sorted by (a, b) -> needs sort
# ------------------------------------------------------------------------------

query II
EXPLAIN SELECT * FROM 'data/parquet-testing/sorted_partial.parquet' ORDER BY a ASC NULLS LAST, b ASC NULLS LAST, c
----
physical_plan	<REGEX>:.*ORDER_BY.*

# ==============================================================================
# SECTION 4: Negative Cases (sort should NOT be eliminated)
# ==============================================================================

# ------------------------------------------------------------------------------
# Test 4.1: Direction mismatch - ORDER BY DESC on ASC sorted file -> needs sort
# ------------------------------------------------------------------------------

query II
EXPLAIN SELECT * FROM 'data/parquet-testing/sorted_i_asc.parquet' ORDER BY i DESC
----
physical_plan	<REGEX>:.*ORDER_BY.*

# ------------------------------------------------------------------------------
# Test 4.2: NULLS FIRST vs NULLS LAST mismatch -> needs sort
# ------------------------------------------------------------------------------

# File has NULLS LAST, query requests NULLS FIRST
query II
EXPLAIN SELECT i FROM 'data/parquet-testing/sorted_i_asc.parquet' ORDER BY i ASC NULLS FIRST
----
physical_plan	<REGEX>:.*ORDER_BY.*

# ------------------------------------------------------------------------------
# Test 4.3: ORDER BY on second column only -> needs sort (not a prefix)
# ------------------------------------------------------------------------------

query II
EXPLAIN SELECT * FROM 'data/parquet-testing/sorted_ij_asc.parquet' ORDER BY j ASC NULLS LAST
----
physical_plan	<REGEX>:.*ORDER_BY.*

# ------------------------------------------------------------------------------
# Test 4.4: Expression in ORDER BY -> needs sort (can't optimize expressions)
# ------------------------------------------------------------------------------

query II
EXPLAIN SELECT * FROM 'data/parquet-testing/sorted_i_asc.parquet' ORDER BY i + 1
----
physical_plan	<REGEX>:.*ORDER_BY.*

# ------------------------------------------------------------------------------
# Test 4.5: Regular file without sorting_columns -> needs sort
# ------------------------------------------------------------------------------

statement ok
COPY (SELECT i FROM range(100) t(i)) TO '__TEST_DIR__/unsorted.parquet' (FORMAT PARQUET)

query II
EXPLAIN SELECT * FROM '__TEST_DIR__/unsorted.parquet' ORDER BY i
----
physical_plan	<REGEX>:.*ORDER_BY.*

# ------------------------------------------------------------------------------
# Test 4.6: Unordered row groups - each RG internally sorted but NOT globally ordered
# ------------------------------------------------------------------------------

# File has sorting_columns metadata in each row group, but row groups are:
# RG0: 500-599, RG1: 0-99, RG2: 300-399 (NOT globally sorted)
# Sort elimination should NOT occur because row groups are not ordered

query II
EXPLAIN SELECT * FROM 'data/parquet-testing/unordered_rowgroups.parquet' ORDER BY i ASC NULLS LAST
----
physical_plan	<REGEX>:.*ORDER_BY.*

# Verify the data starts with 500 (first row group) when read without ORDER BY
query I
SELECT i FROM 'data/parquet-testing/unordered_rowgroups.parquet' LIMIT 5
----
500
501
502
503
504
